# Copie para backend/.env (ignorado pelo git) para desenvolvimento local, ou defina estas
# variáveis no ambiente de produção (Railway). NUNCA versione valores reais.

# ── Ambiente ─────────────────────────────────────────────────────────────────
APP_ENV=development            # production em produção (cookie Secure, avisos de banco efêmero)
# COOKIE_SECURE=false          # só para http local; em produção o padrão é true
# CORS_ORIGINS=                # lista separada por vírgula; vazio = somente mesma origem (recomendado)

# ── Administrador (Dev) — criado na primeira subida, se ainda não existir Dev ─
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=            # mínimo 10 caracteres, com letras e números; defina e depois remova se preferir
# DEV_ADMIN_RESET_PASSWORD=true  # redefine a senha do Dev existente na próxima subida (use uma vez)

# ── Neovero (OBRIGATÓRIO para listar OS/planos) ──────────────────────────────
NEOVERO_USERNAME=
NEOVERO_PASSWORD=
# NEOVERO_URL_BASE=https://grandmassif.api.neovero.com
# Escrita no Neovero (atribuição automática) — DESLIGADA por padrão; ver README antes de habilitar
# NEOVERO_WRITE_ENABLED=false
# NEOVERO_WRITE_DRY_RUN=true

# ── Banco de dados (usuários, sessões, auditoria, overlay de colaboradores) ──
# Opção 1: URL SQLAlchemy (PostgreSQL recomendado)
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Opção 2: Cloud SQL (instância gestao-rh-escalas:southamerica-east1:rh-monitoramento-db)
#          exige credenciais GCP no ambiente (GOOGLE_APPLICATION_CREDENTIALS) + usuário/senha/banco abaixo
# CLOUD_SQL_CONNECTION_NAME=gestao-rh-escalas:southamerica-east1:rh-monitoramento-db
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# CLOUD_SQL_IP_TYPE=public     # ou private
# Sem nenhuma das opções: SQLite local em backend/data/app.db (somente desenvolvimento)
# SQLITE_PATH=

# ── Sessão e segurança ───────────────────────────────────────────────────────
# SESSION_IDLE_MINUTES=25       # expira por inatividade (padrão 25)
# ACTIVITY_WINDOW_MINUTES=5     # maior intervalo entre atividades que conta como tempo ativo
# SESSION_MAX_HOURS=12          # tempo máximo absoluto de uma sessão
# LOGIN_MAX_FAILURES=5          # falhas até bloquear a conta temporariamente
# LOGIN_LOCKOUT_MINUTES=15
# PASSWORD_MIN_LENGTH=10

# ── Sugestões e Suporte (e-mail) ─────────────────────────────────────────────
# SUPORTE_ENTREGA=caixa         # padrão: mensagens ficam na plataforma (tela Mensagens, só Dev). `email` usa o SMTP abaixo
# No modo email, sem SMTP_USER/SMTP_PASSWORD o endpoint /api/suporte responde 503 "não configurado" (nada é simulado).
# SMTP_PASSWORD = senha de app do Gmail (conta com verificação em 2 etapas). Só no ambiente/secret manager.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                 # 587 = STARTTLS; 465 = SSL
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=                    # padrão: SMTP_USER
# SUPORTE_DESTINO=dev.tech@myflux.ai
# SUPORTE_LIMITE_POR_HORA=5
